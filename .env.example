# Paths to the weights and checkouts this code needs. Copy to `.env` and edit,
# then `set -a; source .env; set +a` before running anything.
#
# Weights are not redistributed in this repository.

# MMaDA-8B-MixCoT base model (the student starts here; the teacher is the same
# weights with the LoRA adapter disabled).
export MMADA_OPSD_MODEL=/physis/models/MMaDA-8B-MixCoT

# MAGVITv2 image tokenizer used to decode image tokens to pixels.
export MMADA_OPSD_VQ=/physis/models/magvitv2

# Upstream MMaDA source tree. Defaults to vendor/MMaDA and usually needs no change.
# export MMADA_OPSD_MMADA_SRC=$PWD/vendor/MMaDA

# GenEval2 judge. Either a Hugging Face repo id (needs network) or a local dir.
export MMADA_OPSD_QWEN=Qwen/Qwen3-VL-8B-Instruct
